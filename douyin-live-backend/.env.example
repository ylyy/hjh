# 抖音直播AIGC后台配置示例
# 复制此文件为 .env 并修改配置

# 应用配置
APP_NAME=抖音直播AIGC后台
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 数据库配置
DATABASE_URL=sqlite+aiosqlite:///./data/douyin_live.db

# AI配置 (OpenAI或兼容API)
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

# 抖音直播配置
DOUYIN_LIVE_WS_URL=wss://webcast3-ws-web-lq.douyin.com/webcast/im/push/v2/

# 弹幕配置
DANMU_QUEUE_SIZE=1000
DANMU_BATCH_SIZE=50
DANMU_PROCESS_INTERVAL=0.5

# 投票配置
VOTE_WINDOW_SECONDS=30
VOTE_MIN_COUNT=3

# 礼物配置
GIFT_TRIGGER_THRESHOLD=1
