{
  "name": "ai-assistant-electron",
  "version": "1.0.0",
  "description": "AI助手 - Electron桌面应用",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "api-server": "node electron-api-server.js",
    "dev": "electron . --dev",
    "build": "electron-builder"
  },
  "dependencies": {
    "express": "^4.18.2",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "electron-log": "^5.0.1",
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4"
  },
  "build": {
    "appId": "com.yourcompany.aiassistant",
    "productName": "AI助手",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico"
    }
  }
}
